# "arc" (mainnet, default) or "local" (anvil)
NEXT_PUBLIC_CHAIN=arc
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.arc.io
# Toss contract address from `forge script script/Deploy.s.sol`
NEXT_PUBLIC_TOSS_ADDRESS=
# Arc USDC ERC-20 interface (6 decimals). Override only for local anvil (MockUSDC).
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Server only: relayer EOA private key. Fund it with a few USDC on Arc for gas. Never commit.
RELAYER_PK=

# Optional: WalletConnect / Reown project ID (https://cloud.reown.com). Enables "Wallet app" on phones.
NEXT_PUBLIC_WC_PROJECT_ID=
